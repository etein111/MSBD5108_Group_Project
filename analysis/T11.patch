index 0000000..6fe3aff
--- /dev/null
+++ b/block4/run_t11.py
@@ -0,0 +1,321 @@
+"""Run Block 4 T11 on the existing JevBench evaluation split."""
+
+import argparse
+import csv
+import hashlib
+import json
+import math
+import random
+import sqlite3
+import urllib.request
+from collections import Counter
+from contextlib import closing
+from pathlib import Path
+
+from block3.adapters import (
+    JevAdapter, MockAdapter, Prediction, QwenAdapter, load_demonstrations, prompt_for_record,
+)
+from block3.probes import PROBES, build_probe_set, load_jsonl
+from deployment.protocol import decision_labels
+from deployment.runtime import DEFAULT_CACHE_DIR, DEFAULT_MAX_INPUT_TOKENS, Runtime
+from evaluation.harness import JevBenchHarness
+
+
+MODELS = {"jev": JevAdapter, "qwen": QwenAdapter}
+DEFAULT_SEEDS = (0, 1, 2)
+SCHEMA_VERSION = 1
+DATA = Path("evaluation/data")
+FIELDS = (
+    "schema_version", "backend", "model", "task", "source", "source_type", "type",
+    "probe", "variant", "seed", "sample_id", "record_id", "pair_id", "direction",
+    "gold", "decision", "probability", "logits", "latency_ms", "input_tokens",
+    "output_tokens", "gpu_seconds", "gpu_seconds_proxy", "cost_usd_estimate",
+    "status", "error",
+)
+
+
+def task_for(item):
+    kind = item.get("source_type") or item["type"]
+    source = item["source"]
+    if kind == "score":
+        return "toxicity_score"
+    if source.startswith("phishing_email"):
+        return "phishing_binary"
+    if source in {"sms_spam", "enron_spam"}:
+        return "spam_binary"
+    if "toxic" in source.lower() or "jigsaw" in source.lower():
+        return "toxicity_binary"
+    return f"{source}_binary"
+
+
+def items_for(records, args, seed):
+    clean = list(records)
+    if args.limit_per_source:
+        pools = {}
+        for row in clean:
+            pools.setdefault((row["type"], row["source"]), []).append(row)
+        rng = random.Random(seed)
+        clean = [
+            row for _, pool in sorted(pools.items())
+            for row in rng.sample(pool, min(len(pool), args.limit_per_source))
+        ]
+    return clean + build_probe_set(clean, limit=args.probe_limit_per_type, seed=seed)
+
+
+class HarnessAdapter:
+    def __init__(self, model, seed, args, demonstrations, runtime):
+        self.runtime = runtime
+        self.model = model
+        self.demonstrations = demonstrations
+        self.input_tokens = None
+        if args.backend == "http":
+            self.adapter = MODELS[model](args.base_url, timeout=args.timeout, demonstrations=demonstrations)
+        elif args.backend == "mock":
+            self.adapter = MockAdapter(model, seed)
+
+    def predict_record(self, item):
+        kind = item["type"]
+        options = item["options"] if kind == "choice" else None
+        labels = set(decision_labels(kind, options))
+        self.input_tokens = None
+        if self.runtime is not None:
+            result, tokens = self.runtime.predict(
+                self.model, kind, item["text"], prompt_for_record(item, self.demonstrations), options,
+            )
+            prediction = Prediction(result.decision, result.prob, result.logits, result.latency_ms)
+            self.input_tokens = len(tokens)
+        elif isinstance(self.adapter, MockAdapter):
+            prediction = self.adapter.predict_full(
+                prompt_for_record(item, self.demonstrations), item["text"], kind, options,
+            )
+        else:
+            prediction = self.adapter.predict_full(
+                item["prompt"], item["text"], kind, options, source_type=item.get("source_type"),
+            )
+            self.input_tokens = prediction.input_tokens
+
+        prob = prediction.prob
+        if (
+            set(prob) != labels or set(prediction.logits) != labels
+            or any(not math.isfinite(value) or not 0 <= value <= 1 for value in prob.values())
+            or not math.isclose(sum(prob.values()), 1.0, abs_tol=1e-5)
+            or prob.get(str(prediction.decision)) != max(prob.values())
+            or any(not math.isfinite(value) for value in prediction.logits.values())
+            or not math.isfinite(prediction.latency_ms) or prediction.latency_ms < 0
+        ):
+            raise ValueError("Invalid decision, probability distribution, logits, or latency")
+        return prediction.as_harness_tuple()
+
+
+def result_row(harness, item, model, seed, args):
+    result = harness.evaluate_record(item)
+    success = result["status"] == "success"
+    real = success and args.backend != "mock"
+    latency = result["latency_seconds"] * 1000 if success else None
+    proxy = latency / 1000 if real else None
+    return dict(
+        schema_version=SCHEMA_VERSION, backend=args.backend, model=model, task=task_for(item),
+        source=item["source"], source_type=item.get("source_type", item["type"]), type=item["type"],
+        probe=item.get("probe", "clean"), variant=item.get("variant"), seed=seed,
+        sample_id=item.get("origin_id", item["id"]), record_id=item["id"],
+        pair_id=item.get("pair_id"), direction=item.get("direction"), gold=result["ground_truth"],
+        decision=result["prediction"], probability=result["probability"], logits=result["raw_logits"],
+        latency_ms=latency, input_tokens=harness.adapter.input_tokens if real else None,
+        output_tokens=0 if real else None, gpu_seconds=None, gpu_seconds_proxy=proxy,
+        cost_usd_estimate=(proxy * args.usd_per_gpu_hour / 3600
+                           if proxy is not None and args.usd_per_gpu_hour is not None else None),
+        status="success" if success else "error",
+        error=None if success else result["status"].removeprefix("error: "),
+    )
+
+
+def json_text(value):
+    return json.dumps(value, ensure_ascii=False, allow_nan=False)
+
+
+def setup(args):
+    if args.backend == "local":
+        runtime = Runtime(args.cache_dir, args.max_input_tokens)
+        health = runtime.health()
+    elif args.backend == "http":
+        runtime = None
+        with urllib.request.urlopen(f"{args.base_url.rstrip('/')}/health", timeout=args.timeout) as reply:
+            health = json.load(reply)
+        if health.get("status") != "ready":
+            raise RuntimeError("The model service is not ready")
+    else:
+        return None, {}
+    # These counters change after inference and should not change the resume identity.
+    return runtime, {key: value for key, value in health.items() if not key.startswith("peak_")}
+
+
+def warm_up(harness, items, repeats):
+    representatives = {}
+    for item in items:
+        kind = item["type"]
+        if kind not in representatives or len(item["text"]) < len(representatives[kind]["text"]):
+            representatives[kind] = item
+    for _ in range(repeats):
+        for item in representatives.values():
+            result = harness.evaluate_record(item)
+            if result["status"] != "success":
+                raise RuntimeError(f"Warm-up failed for {item['type']}: {result['status']}")
+
+
+def export(db, directory, manifest):
+    count = Counter()
+    json_tmp = directory / "all_results.jsonl.tmp"
+    csv_tmp = directory / "all_results.csv.tmp"
+    with json_tmp.open("w", encoding="utf-8", newline="\n") as js, \
+            csv_tmp.open("w", encoding="utf-8", newline="") as cs:
+        writer = csv.DictWriter(cs, fieldnames=FIELDS)
+        writer.writeheader()
+        for (payload,) in db.execute("SELECT payload FROM results ORDER BY seed, model, record_id"):
+            row = json.loads(payload)
+            count[row["status"]] += 1
+            js.write(payload + "\n")
+            writer.writerow({key: json_text(value) if isinstance(value, dict) else value
+                             for key, value in row.items()})
+    json_tmp.replace(directory / "all_results.jsonl")
+    csv_tmp.replace(directory / "all_results.csv")
+    summary = {**manifest, "success": count["success"], "error": count["error"],
+               "unattempted": manifest["expected_rows"] - sum(count.values())}
+    temporary = directory / "manifest.json.tmp"
+    temporary.write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    temporary.replace(directory / "manifest.json")
+    return summary
+
+
+def checkpoint(db, manifest):
+    db.execute("CREATE TABLE IF NOT EXISTS manifest (id INTEGER PRIMARY KEY, payload TEXT)")
+    db.execute("""CREATE TABLE IF NOT EXISTS results (
+        seed INTEGER, model TEXT, record_id TEXT, status TEXT, payload TEXT,
+        PRIMARY KEY (seed, model, record_id)
+    )""")
+    payload = json_text(manifest)
+    db.execute("INSERT OR IGNORE INTO manifest VALUES (1, ?)", (payload,))
+    if json.loads(db.execute("SELECT payload FROM manifest WHERE id=1").fetchone()[0]) != manifest:
+        raise ValueError("Run configuration differs from the checkpoint. Use a new --out-dir.")
+    db.commit()
+
+
+def run(db, args, matrix, demonstrations, runtime):
+    for seed, items in matrix.items():
+        random.seed(seed)
+        if runtime is not None:
+            runtime.torch.manual_seed(seed)
+        for model in args.models:
+            done = {
+                record_id for (record_id,) in db.execute(
+                    "SELECT record_id FROM results WHERE seed=? AND model=? AND status='success'",
+                    (seed, model),
+                )
+            }
+            pending = [item for item in items if item["id"] not in done]
+            print(f"seed={seed} model={model}: {len(done)} complete, {len(pending)} pending", flush=True)
+            if not pending:
+                continue
+            adapter = HarnessAdapter(model, seed, args, demonstrations, runtime)
+            harness = JevBenchHarness(str(args.input), adapter)
+            if args.backend != "mock":
+                warm_up(harness, items, args.warmup_per_type)
+            for index, item in enumerate(pending, 1):
+                row = result_row(harness, item, model, seed, args)
+                db.execute(
+                    """INSERT INTO results VALUES (?, ?, ?, ?, ?)
+                       ON CONFLICT(seed, model, record_id) DO UPDATE
+                       SET status=excluded.status, payload=excluded.payload
+                       WHERE results.status!='success'""",
+                    (seed, model, item["id"], row["status"], json_text(row)),
+                )
+                if index % 50 == 0:
+                    db.commit()
+                if index % 500 == 0:
+                    print(f"seed={seed} model={model}: {index}/{len(pending)} attempted", flush=True)
+            db.commit()
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--backend", choices=("local", "http", "mock"), default="local")
+    parser.add_argument("--input", type=Path, default=DATA / "eval.jsonl")
+    parser.add_argument("--shots-file", type=Path, default=DATA / "train.jsonl")
+    parser.add_argument("--out-dir", type=Path, default=Path("block4/outputs/t11"))
+    parser.add_argument("--models", nargs="+", choices=tuple(MODELS), default=list(MODELS))
+    parser.add_argument("--seeds", nargs="+", type=int, default=list(DEFAULT_SEEDS))
+    parser.add_argument("--shots-per-type", type=int, default=4)
+    parser.add_argument("--limit-per-source", type=int)
+    parser.add_argument("--probe-limit-per-type", type=int)
+    parser.add_argument("--warmup-per-type", type=int, default=3)
+    parser.add_argument("--max-input-tokens", type=int, default=DEFAULT_MAX_INPUT_TOKENS)
+    parser.add_argument("--cache-dir", type=Path, default=DEFAULT_CACHE_DIR)
+    parser.add_argument("--base-url", default="http://127.0.0.1:8000")
+    parser.add_argument("--timeout", type=float, default=60)
+    parser.add_argument("--usd-per-gpu-hour", type=float)
+    args = parser.parse_args(argv)
+    if len(set(args.models)) != len(args.models) or len(set(args.seeds)) != len(args.seeds):
+        parser.error("models and seeds must be unique")
+    if any(not 0 <= seed < 2**32 for seed in args.seeds):
+        parser.error("seeds must be between 0 and 4294967295")
+    if not 1 <= args.max_input_tokens <= DEFAULT_MAX_INPUT_TOKENS:
+        parser.error(f"--max-input-tokens must be in [1, {DEFAULT_MAX_INPUT_TOKENS}]")
+    if (
+        args.shots_per_type < 0 or args.warmup_per_type < 0
+        or not math.isfinite(args.timeout) or args.timeout <= 0
+        or any(value is not None and value <= 0 for value in (args.limit_per_source, args.probe_limit_per_type))
+        or (args.usd_per_gpu_hour is not None
+            and (not math.isfinite(args.usd_per_gpu_hour) or args.usd_per_gpu_hour < 0))
+    ):
+        parser.error("invalid counts, timeout, or GPU hourly rate")
+
+    records = load_jsonl(args.input)
+    if not records or len({row["id"] for row in records}) != len(records):
+        parser.error("input must be nonempty with unique sample IDs")
+    demonstrations = load_demonstrations(args.shots_file, args.shots_per_type)
+    matrix = {seed: items_for(records, args, seed) for seed in args.seeds}
+    for items in matrix.values():
+        if len({item["id"] for item in items}) != len(items):
+            parser.error("generated record IDs are not unique")
+    counts = Counter(task_for(item) for item in records)
+    coverage = {
+        str(seed): dict(Counter(f"{task_for(item)}/{item.get('probe', 'clean')}" for item in items))
+        for seed, items in matrix.items()
+    }
+    try:
+        runtime, health = setup(args)
+    except (OSError, RuntimeError, ImportError) as error:
+        parser.exit(2, f"T11 {args.backend} preflight failed: {error}\n")
+    fingerprint_files = [Path(__file__), Path("block3/adapters.py"), Path("block3/probes.py"),
+                         Path("deployment/protocol.py"), Path("deployment/runtime.py"),
+                         Path("evaluation/harness.py")]
+    manifest = {
+        "schema_version": SCHEMA_VERSION, "backend": args.backend, "models": args.models,
+        "seeds": args.seeds, "shots_per_type": args.shots_per_type, "warmup_per_type": args.warmup_per_type,
+        "limit_per_source": args.limit_per_source, "probe_limit_per_type": args.probe_limit_per_type,
+        "usd_per_gpu_hour": args.usd_per_gpu_hour, "environment": health,
+        "base_url": args.base_url if args.backend == "http" else None,
+        "input_sha256": hashlib.sha256(args.input.read_bytes()).hexdigest(),
+        "shots_sha256": hashlib.sha256(args.shots_file.read_bytes()).hexdigest(),
+        "source_sha256": {path.name: hashlib.sha256(path.read_bytes()).hexdigest() for path in fingerprint_files},
+        "input_tasks": dict(counts), "toxicity_binary_present": "toxicity_binary" in counts,
+        "planned_rows_per_model": coverage,
+        "expected_rows": len(args.models) * sum(map(len, matrix.values())),
+        "decoding": "mock_hash" if args.backend == "mock" else "constrained_argmax",
+        "probes": list(PROBES),
+    }
+    if not manifest["toxicity_binary_present"]:
+        print("Dataset coverage: no toxicity binary records in the input.", flush=True)
+    args.out_dir.mkdir(parents=True, exist_ok=True)
+    with closing(sqlite3.connect(args.out_dir / "checkpoint.sqlite3")) as db:
+        checkpoint(db, manifest)
+        try:
+            run(db, args, matrix, demonstrations, runtime)
+        finally:
+            db.commit()
+            summary = export(db, args.out_dir, manifest)
+    print(json_text({key: summary[key] for key in ("expected_rows", "success", "error", "unattempted")}))
+    return bool(summary["error"] or summary["unattempted"])
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
