+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "Block 4 T11 inference attempt",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_version", "backend", "model", "task", "source", "source_type", "type",
+    "probe", "variant", "seed", "sample_id", "record_id", "pair_id", "direction",
+    "gold", "decision", "probability", "logits", "latency_ms", "input_tokens",
+    "output_tokens", "gpu_seconds", "gpu_seconds_proxy", "cost_usd_estimate",
+    "status", "error"
+  ],
+  "properties": {
+    "schema_version": {"const": 1},
+    "backend": {"enum": ["local", "http", "mock"]},
+    "model": {"enum": ["jev", "qwen"]},
+    "task": {"type": "string", "minLength": 1},
+    "source": {"type": "string", "minLength": 1},
+    "source_type": {"enum": ["noul", "score"]},
+    "type": {"enum": ["noul", "score", "choice"]},
+    "probe": {"enum": ["clean", "prompt_injection", "option_renaming", "option_order_permutation", "abstain_removal"]},
+    "variant": {"enum": [null, "original", "perturbed"]},
+    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
+    "sample_id": {"type": "string", "minLength": 1},
+    "record_id": {"type": "string", "minLength": 1},
+    "pair_id": {"type": ["string", "null"]},
+    "direction": {"type": ["string", "null"]},
+    "gold": {"type": ["string", "integer"]},
+    "decision": {"type": ["string", "integer", "null"]},
+    "probability": {
+      "type": ["object", "null"],
+      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
+    },
+    "logits": {"type": ["object", "null"], "additionalProperties": {"type": "number"}},
+    "latency_ms": {"$ref": "#/$defs/nullable_measurement"},
+    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
+    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
+    "gpu_seconds": {"$ref": "#/$defs/nullable_measurement"},
+    "gpu_seconds_proxy": {"$ref": "#/$defs/nullable_measurement"},
+    "cost_usd_estimate": {"$ref": "#/$defs/nullable_measurement"},
+    "status": {"enum": ["success", "error"]},
+    "error": {"type": ["string", "null"]}
+  },
+  "$defs": {
+    "nullable_measurement": {"type": ["number", "null"], "minimum": 0}
+  },
+  "allOf": [
+    {
+      "if": {"properties": {"status": {"const": "success"}}},
+      "then": {
+        "properties": {
+          "decision": {"type": ["string", "integer"]},
+          "probability": {"type": "object", "minProperties": 2},
+          "logits": {"type": "object", "minProperties": 2},
+          "latency_ms": {"type": "number"},
+          "error": {"type": "null"}
+        }
+      },
+      "else": {
+        "properties": {
+          "decision": {"type": "null"},
+          "probability": {"type": "null"},
+          "logits": {"type": "null"},
+          "latency_ms": {"type": "null"},
+          "input_tokens": {"type": "null"},
+          "output_tokens": {"type": "null"},
+          "gpu_seconds": {"type": "null"},
+          "gpu_seconds_proxy": {"type": "null"},
+          "cost_usd_estimate": {"type": "null"},
+          "error": {"type": "string"}
+        }
+      }
+    },
+    {
+      "if": {"properties": {"probe": {"const": "clean"}}},
+      "then": {"properties": {"variant": {"type": "null"}, "pair_id": {"type": "null"}}},
+      "else": {"properties": {"variant": {"enum": ["original", "perturbed"]}, "pair_id": {"type": "string"}}}
+    },
+    {
+      "if": {"properties": {"backend": {"const": "mock"}}},
+      "then": {
+        "properties": {
+          "input_tokens": {"type": "null"},
+          "output_tokens": {"type": "null"},
+          "gpu_seconds": {"type": "null"},
+          "gpu_seconds_proxy": {"type": "null"},
+          "cost_usd_estimate": {"type": "null"}
+        }
+      }
+    }
+  ]
+}
